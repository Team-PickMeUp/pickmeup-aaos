<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android Automotive OS(Pleos Connect) 전용 앱 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <application
        android:name=".PickMeUpApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PickMeUp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PickMeUp"
            android:windowSoftInputMode="adjustResize">
            <!--
              주행 중 사용 가능(Distraction Optimized) 선언.
              선언하지 않으면 기어 D 에서 Pleos 가 "주행 중에는 사용할 수 없습니다" 화면으로 앱을 막음.
              TODO: 정식 출시 전 CarUxRestrictions 로 주행 상태별 기능 제한 필요
                    (예: 주행 중 키보드 입력 금지). 선언만 하면 시스템이 앱을 전부 허용함.
            -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>