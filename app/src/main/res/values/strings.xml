<resources>
    <string name="app_name">PickMeUp</string>

    <!-- 최초 실행 이용약관 동의 -->
    <string name="terms_screen_title">픽미업 최초 실행 동의</string>
    <string name="terms_guide">픽미업을 사용하려면 필수 약관을 모두 동의해야 합니다. 각 항목을 확인한 뒤 전체 동의 여부를 선택해 주세요.</string>
    <string name="terms_guide_sub">위치기반서비스 이용약관은 픽업 기능 제공을 위한 위치 정보 활용에 대한 동의이며, 운영체제 위치 접근 권한은 이후 별도로 요청됩니다. 동의하지 않으면 픽미업 이용을 시작하지 않고 종료하거나 돌아갈 수 있습니다.</string>
    <string name="terms_required">필수</string>
    <string name="terms_view_detail">내용 보기</string>
    <string name="terms_agree_all">전체 동의</string>
    <string name="terms_agree_all_optional">선택</string>
    <string name="terms_agree_and_start">동의하고 시작하기</string>
    <string name="terms_disagree">동의하지 않음</string>
    <string name="terms_footnote">모두 동의하기 전에는 시작하기가 비활성 상태입니다. 동의하지 않으면 픽미업 이용을 시작하지 않고 종료하거나 돌아갈 수 있습니다.</string>

    <string name="terms_service_title">서비스 이용약관</string>
    <string name="terms_service_desc">앱 전반의 사용 규칙, 이용 제한, 책임 소재, 서비스 중단 기준 등 이용에 필요한 내용을 확인합니다.</string>
    <string name="terms_privacy_title">개인정보 처리방침</string>
    <string name="terms_privacy_desc">픽업 대상자의 연락처, 위치, 기기 정보 등 수집되는 개인정보의 항목과 이용 목적을 확인합니다.</string>
    <string name="terms_location_title">위치기반서비스 이용약관</string>
    <string name="terms_location_desc">운전자와 픽업 대상자의 위치 정보를 활용하여 픽업 기능을 제공하는 데 동의합니다. 운영체제 위치 접근 권한은 이후 별도로 요청됩니다.</string>

    <!-- 약관 상세 (Figma 136:14057 위치기반서비스 이용약관 / 136:15187 개인정보 처리방침) -->
    <!-- TODO: 법무 검토된 약관 전문으로 교체. 아래 조항은 Figma의 예시 문구입니다. -->
    <string name="terms_service_intro">서비스 이용약관을 확인하고, 서비스 이용에 필요한 정보를 확인하세요.</string>
    <string name="terms_location_intro">위치기반서비스 이용약관을 확인하고, 서비스 이용에 필요한 정보를 확인하세요.</string>
    <string name="terms_privacy_intro">개인정보 처리방침을 확인하고, 서비스 이용에 필요한 정보를 확인하세요.</string>
    <string name="terms_service_placeholder_title">제 1조 (목적)</string>
    <string name="terms_service_placeholder_body">(서비스 이용약관 전문이 여기에 표시됩니다. Figma에 이 약관 화면 디자인과 문구가 없습니다.)</string>
    <string name="terms_sample_article1_title">제 1조 (목적)</string>
    <string name="terms_sample_article1_body">본 약관은 위치기반서비스 제공자(이하 \"서비스 제공자\")가 제공하는 위치기반서비스(이하 \"서비스\")의 이용과 관련하여 서비스 제공자와 이용자의 권리, 의무 및 책임사항, 기타 필요한 사항을 규정함을 목적으로 합니다.</string>
    <string name="terms_sample_article2_title">제 2조 (용어의 정의)</string>
    <string name="terms_sample_article2_body">본 약관에서 사용하는 용어의 정의는 다음과 같습니다. 1. \"이용자\"라 함은 본 약관을 승인하고 서비스를 이용하는 자를 말합니다. 2. \"개인위치정보\"라 함은 이동전화기 등의 단말기 기기 또는 이용자의 위치를 확인할 수 있는 장치를 통하여 이용자의 위치를 확인할 수 있는 정보를 말합니다. 3. \"위치기반서비스\"라 함은 이용자의 위치정보를 이용하여 정보를 제공하는 서비스를 말합니다.</string>
    <string name="terms_sample_article3_title">제 3조 (약관의 게시와 개정)</string>
    <string name="terms_sample_article3_body">서비스 제공자는 본 약관의 내용을 이용자가 쉽게 알 수 있도록 서비스 초기 화면 또는 연결화면을 통하여 게시합니다. 서비스 제공자는 법률의 규정에 의하여 필요하거나 이용자의 권익을 보호하기 위하여 필요한 경우에는 약관을 개정할 수 있으며, 개정된 약관은 적용일자 이후에 가입한 이용자에 대하여는 그 적용을 요구할 수 있습니다.</string>

